filters:
  and:
    - file.folder.contains("100-Atomics/Concepts")
    - '!file.name.startswith("+")'
    - '!file.name.contains("Template")'
    - file.name != "Concepts"
formulas:
  Outlinks: file.links.length
  Backlinks: file.backlinks.length
  Days Stable: (today() - file.mtime).days.round()
properties:
  file.name:
    displayName: 🧠 Concept
  maturity:
    displayName: 🌱 Maturity
  confidence_level:
    displayName: 🎯 Confidence
  domain:
    displayName: 🧭 Domain
  tags:
    displayName: 🔖 Tags
  related:
    displayName: 🔗 Related
  formula.Outlinks:
    displayName: ➡️ Out
  formula.Backlinks:
    displayName: ⬅️ Back
  formula.Days Stable:
    displayName: 📅 Days Stable
views:
  - type: table
    name: 📋 All Concepts
    order:
      - file.name
      - maturity
      - confidence_level
      - domain
      - formula.Outlinks
      - formula.Backlinks
      - tags
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 280
      maturity: 120
      confidence_level: 110
      domain: 120
      formula.Outlinks: 70
      formula.Backlinks: 70
  - type: cards
    name: 🃏 Concept Cards
    order:
      - file.name
      - maturity
      - domain
      - confidence_level
    limit: 100
  - type: table
    name: 🌱 Seeds
    filters:
      and:
        - maturity == "📤seed"
    order:
      - file.name
      - formula.Outlinks
      - formula.Backlinks
      - formula.Days Stable
    sort:
      - property: file.mtime
        direction: ASC
    columnSize:
      file.name: 300
